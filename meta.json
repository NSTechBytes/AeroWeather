{
  "name": "AeroWeather",
  "main": "index.js",
  "version": "1.0.0.0",
  "minimumNovadeskVersion": "0.9.11.0",
  "author": "NSTechBytes",
  "description": "A transparent, compact weather widget with local weather icons and configurable location.",
  "icon": "assets/icon.ico",
  "preview": "defaultPreview.png",
  "excludeItems": [],
  "setup": {
    "createDesktopShortcut": true,
    "createStartupShortcut": false,
    "runOnStartup": false,
    "installDir": "%ProgramFiles%\\AeroWeather",
    "startMenuFolder": "AeroWeather",
    "setupName": "setup",
    "setupIcon": "assets/icon.ico",
    "enableUninstall": true,
    "launchAfterInstall": false
  }
}
